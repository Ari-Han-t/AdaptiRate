# Copy to .env and replace every value. Never commit .env.

# Signs dashboard JWTs. At least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AR_JWT_SECRET=

# First admin account, created on startup only if no users exist.
AR_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AR_BOOTSTRAP_ADMIN_PASSWORD=

POSTGRES_PASSWORD=

# Optional
# AR_CORS_ORIGINS=https://dashboard.example.com
# AR_COOKIE_SECURE=true
# AR_TRUSTED_PROXIES=10.0.0.0/8
